{
  "name": "meal-plan-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-blog-search-index.js --check && vite build && vite build --ssr src/entry-server.jsx --outDir dist/ssr && node prerender.js && node scripts/check-protected-urls.js && node scripts/check-structured-data.js && node scripts/check-google-indexing.js",
    "generate:blog-index": "node scripts/generate-blog-search-index.js",
    "check:urls": "node scripts/check-protected-urls.js",
    "check:structured-data": "node scripts/check-structured-data.js",
    "check:google-indexing": "node scripts/check-google-indexing.js",
    "check:plans": "node scripts/check-plans.js",
    "check:recipe-quality": "node scripts/check-recipe-quality.js",
    "check:nutrition": "node scripts/check-nutrition.js",
    "lint": "eslint . --max-warnings 0",
    "audit:nutrition": "node scripts/audit-nutrition.js",
    "audit:recipes": "node scripts/check-recipe-quality.js",
    "audit:plans": "node scripts/audit-plans.js",
    "audit:dietary": "node scripts/audit-dietary.js",
    "audit:dependencies": "node scripts/audit-dependencies.js",
    "audit:schema": "node scripts/check-structured-data.js",
    "audit:seo": "node scripts/audit-seo.js",
    "audit:links": "node scripts/audit-links.js",
    "audit:metadata": "node scripts/audit-metadata.js",
    "audit:accessibility": "node scripts/audit-accessibility.js",
    "audit:performance": "node scripts/audit-performance.js",
    "audit:assets": "node scripts/audit-assets.js",
    "audit:live": "node scripts/audit-live.js",
    "audit:all": "npm run audit:nutrition && npm run audit:recipes && npm run audit:dietary && npm run audit:plans && npm run audit:seo && npm run audit:schema && npm run audit:links && npm run audit:metadata && npm run audit:accessibility && npm run audit:performance && npm run audit:assets",
    "check": "npm run lint && npm test && npm run test:security && npm run audit:dependencies && npm run build && npm run check:plans && npm run audit:all",
    "analytics:weekly": "node scripts/weekly-analytics-improvements.js",
    "analytics:weekly:sample": "node scripts/weekly-analytics-improvements.js --sample --dry-run",
    "analytics:weekly:email:dry-run": "node scripts/email-weekly-analytics-report.js --dry-run",
    "test": "node --test scripts/product-funnel.test.js scripts/nutrition-system.test.js scripts/portion-shares.test.js scripts/cooking-quantities.test.js scripts/seo-operations.test.js",
    "test:security": "node scripts/api-guards.test.js",
    "preview": "vite preview",
    "start": "vercel dev"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "googleapis": "^173.0.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "gaxios": "7.3.0"
  }
}
