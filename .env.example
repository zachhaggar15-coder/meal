# Copy this file to ".env" and paste your real OpenAI API key.
# Never commit .env to git.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: choose a model. gpt-4o-mini is cheap and fast.
OPENAI_MODEL=gpt-4o-mini

# Feedback + waitlist emails are sent via Resend.
RESEND_API_KEY=your_resend_api_key_here

# ── MealPrep.org.uk email identity ────────────────────────────────────────────
# Where feedback is delivered, and the reply-to for outgoing emails.
MEALPREP_FEEDBACK_TO_EMAIL=mealprep.org.uk@proton.me
MEALPREP_REPLY_TO_EMAIL=mealprep.org.uk@proton.me
# "From" header. NOTE: Resend can only send from a domain you have verified.
# Verify mealprep.org.uk in Resend, then use e.g. "MealPrep.org.uk <hello@mealprep.org.uk>".
# Until then the code falls back to Resend's onboarding@resend.dev sender.
MEALPREP_FROM_EMAIL="MealPrep.org.uk <hello@mealprep.org.uk>"
MEALPREP_WAITLIST_FROM_EMAIL="MealPrep.org.uk <hello@mealprep.org.uk>"
MEALPREP_PLAN_FROM_EMAIL="MealPrep.org.uk <hello@mealprep.org.uk>"
MEALPREP_REPORT_FROM_EMAIL="MealPrep.org.uk <hello@mealprep.org.uk>"
WEEKLY_ANALYTICS_REPORT_EMAIL_TO=dojostack@protonmail.com

# Legacy names still read as fallbacks (safe to remove once migrated):
# FEEDBACK_TO_EMAIL / FEEDBACK_FROM_EMAIL

# Optional: use a verified sending domain in Resend for production. If this is
# not set, /api/feedback uses Resend's onboarding sender for basic testing.
FEEDBACK_FROM_EMAIL="MealPrep Feedback <feedback@your-verified-domain.co.uk>"

# ── Lemon Squeezy checkout (6-week PDF meal plans) ────────────────────────────
# Leave every VITE_LS_BUY_URL_* var unset until Lemon Squeezy approval lands —
# shop pages render an "Available soon" state with no checkout link instead.
# Run `npm run check:checkout` before setting any of these for real.
#
# Each value is the full "Buy Link" Lemon Squeezy gives you for that product
# (Dashboard → Products → variant → Copy buy link) — paste the whole link,
# not just the variant id, so the code never has to guess the URL format.
# Test-mode links do NOT carry over on approval; use "Copy to Live Mode" on
# each product first, then copy the new live product's own buy link.
VITE_LS_BUY_URL_ALDI_DINNER=
VITE_LS_BUY_URL_ALDI_PROTEIN=
VITE_LS_BUY_URL_LIDL_DINNER=
VITE_LS_BUY_URL_LIDL_PROTEIN=
VITE_LS_BUY_URL_ALDI_BUNDLE=
VITE_LS_BUY_URL_LIDL_BUNDLE=
VITE_LS_BUY_URL_COMPLETE=
# Webhook signing secret. Unlike the buy links, this does not change when the
# store is approved for live sales — safe to set at any time.
LEMONSQUEEZY_WEBHOOK_SECRET=

# Alternative to Resend: send feedback to a private HTTPS webhook such as
# Make, Zapier, n8n or another inbox automation. This keeps the destination
# email out of the frontend and avoids exposing it in page source.
FEEDBACK_WEBHOOK_URL=https://your-private-webhook-url.example

# ── MealPrep+ waitlist (Supabase) ─────────────────────────────────────────────
# Server-side only. The service role key bypasses Row Level Security, so it must
# NEVER be exposed to the browser or committed. Frontend never sees these.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Shared secret that protects /admin and /api/admin-stats. Use a long random
# string, e.g. `openssl rand -hex 32`.
ADMIN_DASHBOARD_TOKEN=change_me_to_a_long_random_string

# Shared serverless rate-limit state. Provision Upstash Redis through the
# Vercel Marketplace so these are injected into every deployed environment.
# API routes fail closed on production/preview when either value is missing.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ── IndexNow (docs/indexnow.md) ───────────────────────────────────────────────
# Both are optional. The daily Vercel cron in vercel.json works without them.
# CRON_SECRET: if set, Vercel sends it to /api/indexnow-sync as a bearer token
# and nothing else is accepted.
# INDEXNOW_DISABLED: set to "true" to stop submissions without a code change.
CRON_SECRET=
INDEXNOW_DISABLED=

# Public analytics configuration. GA defaults to the current production
# measurement ID if omitted; set these explicitly for staging/production splits.
VITE_GA_MEASUREMENT_ID=G-SRW78FVYWM
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
VITE_AHREFS_ANALYTICS_KEY=

# First-party behaviour analytics. Keep consent required in production unless
# you have a separate compliant consent system in front of the site.
VITE_BEHAVIOR_ANALYTICS=true
VITE_ANALYTICS_REQUIRE_CONSENT=true

# Google AdSense. Ads remain completely absent unless the global switch is
# true and the matching slot ID is present. All values are safe to leave unset.
VITE_ADS_ENABLED=false
VITE_ADSENSE_CLIENT_ID=ca-pub-7917111630766281
# Responsive display ad unit used after the introduction and mid-article.
VITE_AD_SLOT_IN_ARTICLE=
# Responsive display ad unit used near the end of individual meal-plan pages.
VITE_AD_SLOT_PLAN_INLINE=

# Weekly analytics automation. These are used by the scheduled GitHub Action
# and by `npm run analytics:weekly` locally. Store the JSON secret in GitHub,
# not in this file.
SEARCH_CONSOLE_SITE_URL=https://www.mealprep.org.uk/
GA4_PROPERTY_ID=123456789
GOOGLE_SERVICE_ACCOUNT_JSON=your_google_service_account_json_or_base64_here
WEEKLY_ANALYTICS_DAYS=28
WEEKLY_ANALYTICS_MIN_IMPRESSIONS=50
WEEKLY_ANALYTICS_STRONG_IMPRESSIONS=100
WEEKLY_ANALYTICS_PRIORITY_IMPRESSIONS=250
WEEKLY_ANALYTICS_COOLDOWN_DAYS=28

# Weekly Amazon link check (scripts/check-amazon-links.js, run by the
# "Weekly Amazon Link Check" GitHub Action every Monday at 15:00 Europe/London).
#
# Without these the check still runs, but only confirms each product URL still
# resolves - it cannot report stock. Stock requires the Amazon Product
# Advertising API, which is the only sanctioned source for live availability;
# scraping product pages from CI gets served a CAPTCHA and produces false
# alarms. Credentials come from the Associates account that owns the affiliate
# tag, at https://affiliate-program.amazon.co.uk/assoc_credentials/home
# (PA-API access requires qualifying sales on the account first).
#
# Store the real values as GitHub Actions secrets, not in this file.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=amazonaf063dc-21

# ── Pinterest ─────────────────────────────────────────────────────────────────
# Domain verification token from Pinterest → Settings → Claimed accounts →
# Claim website → "Add HTML tag". Paste only the token from the tag's content
# attribute, not the whole <meta> element. When set, every page renders
# <meta name="p:domain_verify" content="..."> automatically; when unset, no tag
# is emitted. VITE_PINTEREST_DOMAIN_VERIFICATION is accepted as an alias.
#
# Nothing else about Pinterest is configured here - feeds, boards, eligibility
# and images all live in src/pinterest/config.js. See docs/pinterest.md.
PINTEREST_DOMAIN_VERIFICATION=
